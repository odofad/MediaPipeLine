#!/bin/bash
# Probe the first openable media file in a mag. Write ~/camscan/<mag>.txt.
# Does not move folders. Does not write a mag card. Does not read the middle of a file.
set -euo pipefail

CONF=/etc/mediapipeline/pipe.conf
SLICE_DEFAULT=8388608
TIMEOUT_DEFAULT=25
OPEN_TIMEOUT=15
MAX_TRIES=8
MIN_BYTES=1048576

media_extensions=""
sidecar_extensions=""
ffprobe=""
exiftool=""
mediainfo=""
redline=""
error=""
camscan_slice=""
camscan_timeout=""
slice_defaulted=0
timeout_defaulted=0
mediainfo_defaulted=0

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Ubuntu ships these. A conf path must not hide /usr/bin.
system_bin() {
  local name="$1" base
  base="${name##*/}"
  case "$base" in
    ffmpeg|ffprobe|exiftool|mediainfo)
      if [[ -x "/usr/bin/${base}" ]]; then
        printf '/usr/bin/%s' "$base"
        return 0
      fi
      ;;
  esac
  printf '%s' "$name"
}

timeout_bin=timeout
[[ -x /usr/bin/timeout ]] && timeout_bin=/usr/bin/timeout
iconv_bin=iconv
[[ -x /usr/bin/iconv ]] && iconv_bin=/usr/bin/iconv

# TERM, then KILL. A tool that catches TERM must not hold the walk.
run_to() {
  local secs="$1"
  shift
  "$timeout_bin" --signal=TERM --kill-after=2 "$secs" "$@"
}

load_conf() {
  local line key val
  [[ -f "$CONF" ]] || { echo "missing config: $CONF" >&2; exit 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue
    key="$(trim "${line%%=*}")"
    val="$(trim "${line#*=}")"
    if [[ "$val" == \"*\" && "$val" == *\" ]]; then
      val="${val:1:${#val}-2}"
    fi
    case "$key" in
      media_extensions) media_extensions=$val ;;
      sidecar_extensions) sidecar_extensions=$val ;;
      ffprobe) ffprobe=$val ;;
      exiftool) exiftool=$val ;;
      mediainfo) mediainfo=$val ;;
      redline) redline=$val ;;
      error) error=$val ;;
      camscan_slice) camscan_slice=$val ;;
      camscan_timeout) camscan_timeout=$val ;;
    esac
  done < "$CONF"
  local need
  for need in media_extensions sidecar_extensions ffprobe exiftool; do
    [[ -n "${!need}" ]] || { echo "config missing $need" >&2; exit 1; }
  done
  [[ -n "$redline" ]] || redline="REDline"
  if [[ -z "$mediainfo" ]]; then
    mediainfo="mediainfo"
    mediainfo_defaulted=1
  fi
  ffprobe="$(system_bin "$ffprobe")"
  exiftool="$(system_bin "$exiftool")"
  mediainfo="$(system_bin "$mediainfo")"
  if [[ -z "$camscan_slice" ]]; then
    camscan_slice=$SLICE_DEFAULT
    slice_defaulted=1
  fi
  if [[ -z "$camscan_timeout" ]]; then
    camscan_timeout=$TIMEOUT_DEFAULT
    timeout_defaulted=1
  fi
  [[ "$camscan_slice" =~ ^[0-9]+$ && "$camscan_slice" -gt 0 ]] || { echo "camscan_slice is not a number" >&2; exit 1; }
  [[ "$camscan_timeout" =~ ^[0-9]+$ && "$camscan_timeout" -gt 0 ]] || { echo "camscan_timeout is not a number" >&2; exit 1; }
}

has_ext() {
  local name="${1,,}" list="$2" ext
  for ext in $list; do
    [[ "$name" == *"$ext" ]] && return 0
  done
  return 1
}

has_media() {
  local dir="$1" f
  for f in "$dir"/*; do
    [[ -f "$f" ]] || continue
    has_ext "$f" "$media_extensions" && return 0
  done
  return 1
}

# Run a command into a file. Print 124 or 137 when it is stopped, else 0 when
# the file has text, else the command's status. A stopped command may still
# have written a partial file.
capture() {
  local secs="$1" dest="$2"
  shift 2
  local rc=0
  : >"$dest"
  if command -v "$timeout_bin" >/dev/null 2>&1; then
    run_to "$secs" "$@" >"$dest" 2>/dev/null || rc=$?
  else
    "$@" >"$dest" 2>/dev/null || rc=$?
  fi
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    printf '%s' "$rc"
    return 0
  fi
  if [[ -s "$dest" ]]; then
    printf '0'
    return 0
  fi
  printf '%s' "$rc"
}

# Like capture, but keep the first stderr line. A stopped command is still 124 or 137.
capture_split() {
  local secs="$1" dest="$2" errf="$3"
  shift 3
  local rc=0 errtmp line
  : >"$dest"
  : >"$errf"
  errtmp="$(mktemp)"
  if command -v "$timeout_bin" >/dev/null 2>&1; then
    run_to "$secs" "$@" >"$dest" 2>"$errtmp" || rc=$?
  else
    "$@" >"$dest" 2>"$errtmp" || rc=$?
  fi
  line="$(grep -m1 . "$errtmp" || true)"
  printf '%s\n' "$line" >"$errf"
  rm -f "$errtmp"
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    printf '%s' "$rc"
    return 0
  fi
  if [[ -s "$dest" ]]; then
    printf '0'
    return 0
  fi
  printf '%s' "$rc"
}

# "timed out" when the tool was stopped. "failed <status>" when it exited with
# no stdout. An empty success stays empty, and the section is then "none".
note_fail() {
  local rc="$1" dest="$2" errf="$3" line
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    mark_timeout "$rc" "$dest"
    return 0
  fi
  [[ -s "$dest" ]] && return 0
  [[ "$rc" -eq 0 ]] && return 0
  printf 'failed %s\n' "$rc" >"$dest"
  line="$(trim "$(cat "$errf" 2>/dev/null || true)")"
  [[ -n "$line" ]] && printf '%s\n' "$line" >>"$dest"
}

# 4294967295 is the empty Sony serial. Zero is the same kind of empty.
drop_empty_serial() {
  local dest="$1" tmp
  [[ -s "$dest" ]] || return 0
  tmp="$(mktemp)"
  grep -v -E 'DeviceSerialNo[[:space:]]*:[[:space:]]*(4294967295|0)[[:space:]]*$' "$dest" >"$tmp" || true
  cat "$tmp" >"$dest"
  rm -f "$tmp"
}

mark_timeout() {
  local rc="$1" dest="$2" tmp
  [[ "$rc" -eq 124 || "$rc" -eq 137 ]] || return 0
  tmp="$(mktemp)"
  printf 'timed out\n' >"$tmp"
  if [[ -s "$dest" ]]; then
    cat "$dest" >>"$tmp"
  fi
  cat "$tmp" >"$dest"
  rm -f "$tmp"
}

xml_chunk() {
  local src="$1" label="$2" pattern="$3" cap="$4" hits
  hits="$(grep -a -o -E "$pattern" "$src" 2>/dev/null | head -n "$cap" || true)"
  [[ -n "$hits" ]] || return 0
  printf '%s\n%s\n' "$label" "$hits"
}

xml_body() {
  local src="$1" names
  [[ -s "$src" ]] || return 0
  xml_chunk "$src" "panasonic:" '<(Manufacturer|ModelName|CaptureGamma|CaptureGamut)>[^<]+' 20
  xml_chunk "$src" "device:" '<(DeviceManufacturer|DeviceModelName|DeviceSerialNo)>[^<]+' 20
  xml_chunk "$src" "sony name-value:" 'Item name="[^"]+" value="[^"]+"' 40
  xml_chunk "$src" "sony value-name:" 'Item value="[^"]+" name="[^"]+"' 40
  names="$(grep -a -o -E 'Item name="[^"]+"' "$src" 2>/dev/null | sort -u | head -n 40 || true)"
  [[ -n "$names" ]] && printf 'item names:\n%s\n' "$names"
}

utf16_media() {
  local file="$1" enc="$2" dest="$3" part shifted bytes
  : >"$dest"
  command -v "$iconv_bin" >/dev/null 2>&1 || return 1
  part="$(mktemp)"
  shifted="$(mktemp)"
  decode_part() {
    "$iconv_bin" -f "$enc" -t UTF-8 -c "$part" >>"$dest" 2>/dev/null || true
    tail -c +2 "$part" >"$shifted" 2>/dev/null || true
    "$iconv_bin" -f "$enc" -t UTF-8 -c "$shifted" >>"$dest" 2>/dev/null || true
  }
  head -c "$camscan_slice" "$file" >"$part"
  decode_part
  bytes="$(stat -c '%s' "$file")"
  if [[ "$bytes" -gt "$camscan_slice" ]]; then
    tail -c "$camscan_slice" "$file" >"$part"
    decode_part
  fi
  rm -f "$part" "$shifted"
  return 0
}

write_section_file() {
  local title="$1" src="$2"
  printf '[%s]\n' "$title" >>"$report"
  if [[ ! -s "$src" ]]; then
    printf 'none\n\n' >>"$report"
  else
    cat "$src" >>"$report"
    printf '\n' >>"$report"
  fi
}

file_opens() {
  local f="$1" lower out
  open_how=""
  lower="${f,,}"
  if [[ "$lower" == *.r3d && -s "$f" ]]; then
    open_how="r3d"
    return 0
  fi
  if command -v "$ffprobe" >/dev/null 2>&1; then
    out="$(run_to "$OPEN_TIMEOUT" "$ffprobe" -v error -show_format \
      -show_entries format=format_name -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null || true)"
    if [[ -n "$(trim "$out")" ]]; then
      open_how="ffprobe"
      return 0
    fi
  fi
  if command -v "$exiftool" >/dev/null 2>&1; then
    out="$(run_to "$OPEN_TIMEOUT" "$exiftool" -s3 -FileType "$f" 2>/dev/null || true)"
    if [[ -n "$(trim "$out")" ]]; then
      open_how="exiftool"
      return 0
    fi
  fi
  return 1
}

pick_file() {
  local mag="$1" f name tries=0 size
  local -a names=()
  chosen=""
  open_how=""
  stop_reason=""
  skipped=()
  for f in "$mag"/*; do
    [[ -f "$f" ]] || continue
    has_ext "$f" "$media_extensions" || continue
    names+=("$f")
  done
  [[ ${#names[@]} -gt 0 ]] || return 1
  local sorted
  sorted="$(mktemp)"
  printf '%s\n' "${names[@]}" | sort >"$sorted"
  mapfile -t names <"$sorted"
  rm -f "$sorted"
  for f in "${names[@]}"; do
    name="${f##*/}"
    tries=$((tries + 1))
    if [[ "$tries" -gt "$MAX_TRIES" ]]; then
      stop_reason="stopped after ${MAX_TRIES} files"
      return 1
    fi
    if [[ ! -s "$f" ]]; then
      skipped+=("$name empty")
      continue
    fi
    size="$(stat -c '%s' "$f")"
    if [[ "$size" -lt "$MIN_BYTES" ]]; then
      skipped+=("$name too small")
      continue
    fi
    echo "  try $name"
    if file_opens "$f"; then
      chosen="$f"
      return 0
    fi
    skipped+=("$name unreadable")
  done
  return 1
}

find_sidecar() {
  local file="$1" mag="$2"
  local stem stemlower place cand base lower ext
  stem="${file##*/}"
  stem="${stem%.*}"
  stemlower="${stem,,}"
  for place in "${file%/*}" "$mag/CLIP"; do
    [[ -d "$place" ]] || continue
    for cand in "$place"/*; do
      [[ -f "$cand" ]] || continue
      base="${cand##*/}"
      lower="${base,,}"
      for ext in $sidecar_extensions; do
        if [[ "$lower" == "${stemlower}${ext}" ]]; then
          printf '%s' "$cand"
          return 0
        fi
      done
    done
  done
  return 1
}

sidecars_in() {
  local dir="$1" cand
  [[ -d "$dir" ]] || return 0
  for cand in "$dir"/*; do
    [[ -f "$cand" ]] || continue
    has_ext "$cand" "$sidecar_extensions" || continue
    printf '%s\n' "$cand"
  done
}

fill_sidecar() {
  local file="$1" mag="$2" dest="$3" side count cand list sorted
  local -a xmls=() found=()
  : >"$dest"
  side="$(find_sidecar "$file" "$mag" || true)"
  if [[ -n "$side" ]]; then
    {
      printf 'file: %s\n' "${side##*/}"
      xml_body "$side" || true
    } >"$dest"
    return 0
  fi
  list="$(mktemp)"
  sorted="$(mktemp)"
  sidecars_in "${file%/*}" >"$list"
  if [[ "${file%/*}" != "$mag" ]]; then
    sidecars_in "$mag" >>"$list"
  fi
  sidecars_in "$mag/CLIP" >>"$list"
  sort -u "$list" >"$sorted"
  mapfile -t xmls <"$sorted"
  rm -f "$list" "$sorted"
  for cand in "${xmls[@]}"; do
    [[ -n "$cand" ]] || continue
    found+=("$cand")
  done
  count="${#found[@]}"
  if [[ "$count" -eq 0 ]]; then
    return 0
  fi
  if [[ "$count" -eq 1 ]]; then
    {
      printf 'file: %s\n' "${found[0]##*/}"
      printf '%s\n' "note: only sidecar in the mag, stem does not match"
      xml_body "${found[0]}" || true
    } >"$dest"
    return 0
  fi
  {
    printf 'note: %s sidecars, not guessing\n' "$count"
    for cand in "${found[@]}"; do
      printf 'file: %s\n' "${cand##*/}"
    done
  } >"$dest"
}

fill_ffprobe() {
  local file="$1" streams="$2" tags="$3" raw err rc filtered
  raw="$(mktemp)"
  err="$(mktemp)"
  : >"$streams"
  : >"$tags"
  if ! command -v "$ffprobe" >/dev/null 2>&1; then
    printf 'not found\n' >"$streams"
    rm -f "$raw" "$err"
    return 0
  fi
  rc="$(capture_split "$OPEN_TIMEOUT" "$raw" "$err" "$ffprobe" -v error -hide_banner \
    -show_format -show_streams \
    -show_entries 'format=format_name,duration,size:stream=codec_type,codec_name,width,height,avg_frame_rate,pix_fmt,color_space,color_transfer,color_primaries,bits_per_raw_sample,channels' \
    -of default=noprint_wrappers=1 "$file")"
  note_fail "$rc" "$raw" "$err"
  if [[ -s "$raw" ]]; then
    cat "$raw" >"$streams"
  fi
  rc="$(capture_split "$OPEN_TIMEOUT" "$raw" "$err" "$ffprobe" -v error -hide_banner \
    -show_format -show_entries format_tags -of default=noprint_wrappers=1 "$file")"
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    printf 'timed out\n' >"$tags"
  elif [[ "$rc" -ne 0 ]]; then
    note_fail "$rc" "$raw" "$err"
    cat "$raw" >"$tags"
  else
    filtered="$(grep -iE 'make|model|manufacturer|comment|encoder|creation|com\.apple|dji|insta|sony|panasonic|gamma|gamut|color|handler|software|device' "$raw" || true)"
    if [[ -n "$filtered" ]]; then
      printf '%s\n' "$filtered" >"$tags"
    fi
  fi
  rm -f "$raw" "$err"
}

fill_mediainfo() {
  local file="$1" dest="$2" raw err rc line
  raw="$(mktemp)"
  err="$(mktemp)"
  : >"$dest"
  if ! command -v "$mediainfo" >/dev/null 2>&1; then
    printf 'not found\n' >"$dest"
    rm -f "$raw" "$err"
    return 0
  fi
  printf 'whole file, header only\n' >"$dest"
  rc="$(capture_split "$camscan_timeout" "$raw" "$err" \
    env COLUMNS=240 "$mediainfo" --Full --ParseSpeed=0 --Language=raw "$file")"
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    printf 'timed out\n' >>"$dest"
  elif [[ "$rc" -ne 0 && ! -s "$raw" ]]; then
    printf 'failed %s\n' "$rc" >>"$dest"
    line="$(grep -m1 . "$err" || true)"
    [[ -n "$line" ]] && printf '%s\n' "$line" >>"$dest"
    rm -f "$raw" "$err"
    return 0
  fi
  awk '
    /^[^[:space:]]/ && index($0, ":") == 0 { sec = $0; next }
    sec ~ /^Audio/ || sec ~ /^Menu/ { next }
    $0 ~ /FileSize|Duration\/|StreamSize|OverallBitRate|FrameCount|HeaderSize|FooterSize|DataSize|IsStreamable|File_Modified|Tagged_Date|Encoded_Date|CompleteName|FolderName|FileName|StreamCount|StreamKind|Count / { next }
    sec ~ /^Other/ { print; next }
    tolower($0) ~ /gamma|gamut|make|model|manufacturer|camera|device|profile|primar|transfer|matrix|colour|color|sony|panasonic|dji|insta|apple|pxw|ilme|acquisition|encoded_application|encoded_hardware|encoded_library|hdr_|picture|writing_application/ { print }
  ' "$raw" | head -n 200 >>"$dest"
  rm -f "$raw" "$err"
}

# One line per media file in the mag. Header only. Not a camera word.
# Columns: codec, bit depth, transfer, primaries, matrix, range, HDR compatibility.
# A third argument limits the walk to that one file.
fill_colour_pairs() {
  local mag="$1" dest="$2" only="${3:-}" f raw err rc line name norm
  local list tally count=0
  : >"$dest"
  if ! command -v "$mediainfo" >/dev/null 2>&1; then
    printf 'not found\n' >"$dest"
    return 0
  fi
  list="$(mktemp)"
  tally="$(mktemp)"
  if [[ -n "$only" ]]; then
    printf '%s\n' "$only" >"$list"
  else
    for f in "$mag"/*; do
      [[ -f "$f" ]] || continue
      has_ext "$f" "$media_extensions" || continue
      [[ -s "$f" ]] || continue
      printf '%s\n' "$f" >>"$list"
    done
  fi
  if [[ ! -s "$list" ]]; then
    rm -f "$list" "$tally"
    return 0
  fi
  while IFS= read -r f; do
    count=$((count + 1))
    name="${f##*/}"
    echo "  colour $count $name"
    raw="$(mktemp)"
    err="$(mktemp)"
    rc="$(capture_split "$OPEN_TIMEOUT" "$raw" "$err" \
      env COLUMNS=240 "$mediainfo" --ParseSpeed=0 \
      --Inform='Video;%Format%|%BitDepth%|%transfer_characteristics%|%colour_primaries%|%matrix_coefficients%|%colour_range%|%HDR_Format_Compatibility%\n' \
      "$f")"
    if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
      printf '%s\ttimed out\n' "$name" >>"$tally"
    elif [[ ! -s "$raw" ]]; then
      printf '%s\tnone\n' "$name" >>"$tally"
    else
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        norm="$(printf '%s\n' "$line" | awk -F '|' 'BEGIN { OFS="\t" } {
          n = 7
          for (i = 1; i <= n; i++) if ($i == "") $i = "-"
          out = $1
          for (i = 2; i <= n; i++) out = out OFS $i
          print out
        }')"
        printf '%s\t%s\n' "$name" "$norm" >>"$tally"
      done <"$raw"
    fi
    rm -f "$raw" "$err"
  done <"$list"
  rm -f "$list"
  {
    printf '%s\n' "# every media file in the mag. header only. not a camera word."
    if [[ -n "$only" ]]; then
      printf '%s\n' "# folder scan. this is the one opened file. the other clips were not read."
    fi
    printf 'files: %s\n' "$count"
    local pairs distinct
    pairs="$(awk -F '\t' '$2 != "timed out" && $2 != "none" {
      p = $2
      for (i = 3; i <= NF; i++) p = p "  " $i
      print p
    }' "$tally" | sort | uniq -c | sed 's/^[[:space:]]*//')"
    if [[ -z "$pairs" ]]; then
      printf 'distinct: 0\n'
    else
      distinct="$(printf '%s\n' "$pairs" | grep -c . || true)"
      printf 'distinct: %s\n' "$distinct"
      printf '%s\n' "$pairs"
    fi
    awk -F '\t' '{
      if ($2 == "timed out" || $2 == "none") { print $1 "  " $2; next }
      out = $1
      for (i = 2; i <= NF; i++) out = out "  " $i
      print out
    }' "$tally"
  } >"$dest"
  rm -f "$tally"
}

exif_header_one() {
  local slice="$1" dest="$2" raw err rc
  raw="$(mktemp)"
  err="$(mktemp)"
  : >"$dest"
  rc="$(capture_split "$OPEN_TIMEOUT" "$raw" "$err" "$exiftool" -fast -m -s \
    -Make -Model -CameraModelName -DeviceManufacturer -DeviceModelName -DeviceSerialNo \
    -CaptureGammaEquation -CaptureColorPrimaries -CaptureGamma -CaptureGamut \
    -Gamma -ColorSpace -ColorPrimaries -PictureProfile -GammaType -Category \
    "$slice")"
  note_fail "$rc" "$raw" "$err"
  drop_empty_serial "$raw"
  [[ -s "$raw" ]] && cat "$raw" >"$dest"
  rm -f "$raw" "$err"
}

fill_exif_header() {
  local head="$1" tail="$2" dest="$3" part
  : >"$dest"
  if ! command -v "$exiftool" >/dev/null 2>&1; then
    printf 'not found\n' >"$dest"
    return 0
  fi
  part="$(mktemp)"
  exif_header_one "$head" "$part"
  if [[ -s "$part" ]]; then
    printf 'head\n' >>"$dest"
    cat "$part" >>"$dest"
  fi
  if [[ -n "$tail" && -s "$tail" ]]; then
    exif_header_one "$tail" "$part"
    if [[ -s "$part" ]]; then
      printf 'tail\n' >>"$dest"
      cat "$part" >>"$dest"
    fi
  fi
  rm -f "$part"
}

exif_embedded_one() {
  local slice="$1" dest="$2" raw err rc wide line
  raw="$(mktemp)"
  err="$(mktemp)"
  : >"$dest"
  rc=0
  if command -v "$timeout_bin" >/dev/null 2>&1; then
    run_to "$camscan_timeout" \
      "$exiftool" -fast -m -a -s -G1 -ee "$slice" >"$raw" 2>"$err" || rc=$?
  else
    "$exiftool" -fast -m -a -s -G1 -ee "$slice" >"$raw" 2>"$err" || rc=$?
  fi
  line="$(grep -m1 . "$err" || true)"
  wide="$(grep -iE 'gamma|gamut|color|primar|picture|profile|device|make|model|manufacturer|category' "$raw" | head -n 80 || true)"
  if [[ "$rc" -eq 124 || "$rc" -eq 137 ]]; then
    printf 'timed out\n' >"$dest"
  elif [[ "$rc" -ne 0 && -z "$wide" ]]; then
    printf 'failed %s\n' "$rc" >"$dest"
    [[ -n "$line" ]] && printf '%s\n' "$line" >>"$dest"
  fi
  if [[ -n "$wide" ]]; then
    printf '%s\n' "$wide" >>"$dest"
  fi
  drop_empty_serial "$dest"
  rm -f "$raw" "$err"
}

fill_exif_embedded() {
  local head="$1" tail="$2" dest="$3" part
  : >"$dest"
  if ! command -v "$exiftool" >/dev/null 2>&1; then
    printf 'not found\n' >"$dest"
    return 0
  fi
  part="$(mktemp)"
  exif_embedded_one "$head" "$part"
  if [[ -s "$part" ]]; then
    printf 'head\n' >>"$dest"
    cat "$part" >>"$dest"
  fi
  if [[ -n "$tail" && -s "$tail" ]]; then
    exif_embedded_one "$tail" "$part"
    if [[ -s "$part" ]]; then
      printf 'tail\n' >>"$dest"
      cat "$part" >>"$dest"
    fi
  fi
  rm -f "$part"
}

fill_redline() {
  local file="$1" dest="$2" raw rc lower
  raw="$(mktemp)"
  : >"$dest"
  lower="${file,,}"
  if [[ "$lower" != *.r3d ]]; then
    printf 'not r3d\n' >"$dest"
    rm -f "$raw"
    return 0
  fi
  if ! command -v "$redline" >/dev/null 2>&1; then
    printf 'not found\n' >"$dest"
    rm -f "$raw"
    return 0
  fi
  rc="$(capture "$camscan_timeout" "$raw" "$redline" --i "$file" --printMeta 1)"
  mark_timeout "$rc" "$raw"
  if [[ -s "$raw" ]]; then
    head -n 120 "$raw" >"$dest"
  fi
  rm -f "$raw"
}

scan_mag() {
  local mag="$1" mag_abs mag_name file body slice head_slice tail_slice u16 bytes
  local streams tags header embedded info red side_body
  mag_abs="$(cd "$mag" && pwd)"
  mag_name="$(basename "$mag_abs")"
  if [[ "$mag_abs" == "/" || "$mag_abs" == "$HOME" ]]; then
    echo "refusing $mag_abs" >&2
    return 1
  fi
  report="${out_dir}/${mag_name}.txt"
  echo "$mag_name"
  if ! pick_file "$mag_abs"; then
    {
      printf '%s\n' "# camscan report. Not a mag card. Detection does not read this file."
      printf 'mag: %s\n' "$mag_name"
      printf 'path: %s\n' "$mag_abs"
      printf 'file: none\n'
      if [[ -n "$stop_reason" ]]; then
        printf 'note: %s\n' "$stop_reason"
      else
        printf 'note: no openable media file\n'
      fi
      local s
      for s in "${skipped[@]}"; do
        printf 'skipped: %s\n' "$s"
      done
      printf '\n'
    } >"$report"
    local pairs
    pairs="$(mktemp)"
    if [[ "${pairs_one:-0}" -eq 1 ]]; then
      {
        printf '[colour-pairs]\n'
        printf '%s\n' "# folder scan. this mag did not open. the other clips were not read."
        printf 'files: 0\n\n'
      } >>"$report"
    else
      fill_colour_pairs "$mag_abs" "$pairs"
      write_section_file "colour-pairs" "$pairs"
    fi
    rm -f "$pairs"
    echo "  wrote $report"
    return 0
  fi
  file="$chosen"
  echo "  ${file##*/}"
  bytes="$(stat -c '%s' "$file")"
  slice="$(mktemp)"
  head_slice="$(mktemp)"
  tail_slice=""
  head -c "$camscan_slice" "$file" >"$head_slice"
  cat "$head_slice" >"$slice"
  if [[ "$bytes" -gt "$camscan_slice" ]]; then
    tail_slice="$(mktemp)"
    tail -c "$camscan_slice" "$file" >"$tail_slice"
    cat "$tail_slice" >>"$slice"
  fi

  {
    printf '%s\n' "# camscan report. Not a mag card. Detection does not read this file."
    printf '%s\n' "# ffprobe colour tags in this file are not a camera word."
    printf '%s\n' "# mediainfo colour, transfer, and matrix lines are not a camera word."
    if [[ "${pairs_one:-0}" -eq 1 ]]; then
      printf '%s\n' "# colour-pairs is this one file. the other clips were not read."
    else
      printf '%s\n' "# colour-pairs lists every media file. That list is not a camera word."
    fi
    printf 'mag: %s\n' "$mag_name"
    printf 'path: %s\n' "$mag_abs"
    printf 'file: %s\n' "${file##*/}"
    printf 'opened: %s\n' "$open_how"
    printf 'bytes: %s\n' "$bytes"
    printf 'slice: %s\n' "$camscan_slice"
    printf 'scanned: %s\n' "$(date -Iseconds)"
    local s
    for s in "${skipped[@]}"; do
      printf 'skipped: %s\n' "$s"
    done
    printf '\n'
  } >"$report"

  streams="$(mktemp)"
  tags="$(mktemp)"
  header="$(mktemp)"
  embedded="$(mktemp)"
  info="$(mktemp)"
  red="$(mktemp)"
  side_body="$(mktemp)"
  u16="$(mktemp)"

  fill_ffprobe "$file" "$streams" "$tags"
  write_section_file "ffprobe" "$streams"
  write_section_file "ffprobe-tags" "$tags"

  fill_mediainfo "$file" "$info"
  write_section_file "mediainfo" "$info"

  local pairs
  pairs="$(mktemp)"
  if [[ "${pairs_one:-0}" -eq 1 ]]; then
    fill_colour_pairs "$mag_abs" "$pairs" "$file"
  else
    fill_colour_pairs "$mag_abs" "$pairs"
  fi
  write_section_file "colour-pairs" "$pairs"
  rm -f "$pairs"

  fill_exif_header "$head_slice" "$tail_slice" "$header"
  write_section_file "exiftool" "$header"

  fill_exif_embedded "$head_slice" "$tail_slice" "$embedded"
  write_section_file "exiftool-embedded" "$embedded"

  body="$(xml_body "$slice" || true)"
  printf '%s' "$body" >"$side_body"
  write_section_file "xml" "$side_body"

  if utf16_media "$file" UTF-16LE "$u16"; then
    body="$(xml_body "$u16" || true)"
    printf '%s' "$body" >"$side_body"
  else
    printf 'iconv not found\n' >"$side_body"
  fi
  write_section_file "xml-utf16le" "$side_body"

  if utf16_media "$file" UTF-16BE "$u16"; then
    body="$(xml_body "$u16" || true)"
    printf '%s' "$body" >"$side_body"
  else
    printf 'iconv not found\n' >"$side_body"
  fi
  write_section_file "xml-utf16be" "$side_body"

  fill_sidecar "$file" "$mag_abs" "$side_body"
  write_section_file "sidecar" "$side_body"

  fill_redline "$file" "$red"
  write_section_file "redline" "$red"

  rm -f "$streams" "$tags" "$header" "$embedded" "$info" "$red" "$side_body" "$u16" "$slice" "$head_slice"
  [[ -n "$tail_slice" ]] && rm -f "$tail_slice"
  echo "  wrote $report"
}

usage() {
  echo "usage: mediapipeline-camscan [path]" >&2
  echo "no path scans the error folder from ${CONF}" >&2
  echo "a path with media files is one mag. otherwise each child directory is a mag." >&2
  echo "writes \$HOME/camscan/<mag name>.txt" >&2
}

main() {
  local target mag
  local -a mags=()
  shopt -s nullglob
  [[ -n "${HOME:-}" ]] || { echo "HOME is not set" >&2; exit 1; }
  load_conf
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  if [[ $# -gt 1 ]]; then
    usage
    exit 1
  fi
  if [[ $# -eq 0 ]]; then
    [[ -n "$error" ]] || { echo "config missing error" >&2; exit 1; }
    target="$error"
  else
    target="$1"
  fi
  [[ -d "$target" ]] || { echo "not a directory: $target" >&2; exit 1; }
  target="$(cd "$target" && pwd)"
  if has_media "$target"; then
    mags=("$target")
  else
    for mag in "$target"/*; do
      [[ -d "$mag" ]] || continue
      mags+=("$mag")
    done
  fi
  [[ ${#mags[@]} -gt 0 ]] || { echo "no mags in $target" >&2; exit 1; }
  pairs_one=0
  if [[ ${#mags[@]} -gt 1 ]]; then
    pairs_one=1
    echo "folder scan: one opened file per mag, then the next mag"
  fi
  out_dir="${HOME}/camscan"
  mkdir -p "$out_dir"
  if [[ "$mediainfo_defaulted" -eq 1 ]]; then
    echo "mediainfo is not in the live conf. using ${mediainfo}."
  fi
  if [[ "$slice_defaulted" -eq 1 ]]; then
    echo "camscan_slice is not in the live conf. using ${camscan_slice}."
  fi
  if [[ "$timeout_defaulted" -eq 1 ]]; then
    echo "camscan_timeout is not in the live conf. using ${camscan_timeout}."
  fi
  echo "scanning $target"
  for mag in "${mags[@]}"; do
    scan_mag "$mag"
  done
}

chosen=""
open_how=""
stop_reason=""
report=""
out_dir=""
pairs_one=0
main "$@"
