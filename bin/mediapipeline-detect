#!/bin/bash
# One detection pass. Reads /etc/mediapipeline/pipe.conf.
# Writes a mag card and stops. Does not encode. Does not read colour.
set -euo pipefail

CONF=/etc/mediapipeline/pipe.conf
ERROR_LOG=/var/log/mediapipeline/detect.log

logged=""
relog=""
error=""
settle_seconds=""
lock_file=""
card_suffix=""
media_extensions=""
ffprobe=""
redline=""
copyright=""
owner=""
declare -A clip_id=()
declare -A clip_comment=()

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Ubuntu ships these. A conf path must not hide /usr/bin.
system_bin() {
  local name="$1" base
  base="${name##*/}"
  case "$base" in
    ffmpeg|ffprobe)
      if [[ -x "/usr/bin/${base}" ]]; then
        printf '/usr/bin/%s' "$base"
        return 0
      fi
      ;;
  esac
  printf '%s' "$name"
}

load_conf() {
  local line key val
  [[ -f "$CONF" ]] || { echo "missing config: $CONF" >&2; exit 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue
    key="$(trim "${line%%=*}")"
    val="$(trim "${line#*=}")"
    if [[ "$val" == \"*\" && "$val" == *\" ]]; then
      val="${val:1:${#val}-2}"
    fi
    case "$key" in
      logged) logged=$val ;;
      relog) relog=$val ;;
      error) error=$val ;;
      settle_seconds) settle_seconds=$val ;;
      lock_file) lock_file=$val ;;
      card_suffix) card_suffix=$val ;;
      media_extensions) media_extensions=$val ;;
      ffprobe) ffprobe=$val ;;
      redline) redline=$val ;;
      copyright) copyright=$val ;;
      owner) owner=$val ;;
    esac
  done < "$CONF"
  local need
  for need in logged relog error settle_seconds lock_file card_suffix media_extensions ffprobe; do
    [[ -n "${!need}" ]] || { log_error "config missing $need"; echo "config missing $need" >&2; exit 1; }
  done
  [[ -n "$redline" ]] || redline="REDline"
  ffprobe="$(system_bin "$ffprobe")"
  [[ "$settle_seconds" =~ ^[0-9]+$ ]] || { log_error "settle_seconds is not a number"; echo "settle_seconds is not a number" >&2; exit 1; }
}

log_error() {
  mkdir -p "$(dirname "$ERROR_LOG")" 2>/dev/null || true
  printf '%s %s\n' "$(date -Iseconds)" "$*" >> "$ERROR_LOG" || echo "could not write $ERROR_LOG" >&2
}

has_ext() {
  local name="${1,,}" list="$2" ext
  for ext in $list; do
    [[ "$name" == *"$ext" ]] && return 0
  done
  return 1
}

is_dated_name() {
  local name="$1"
  [[ "$name" =~ ^([0-9]{4})_([0-9]{2})_([0-9]{2})_ ]] || return 1
  date -d "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}" +%F >/dev/null 2>&1
}

known() {
  local v
  v="$(trim "${1:-}")"
  if [[ -z "$v" ]]; then
    printf 'unknown'
  else
    printf '%s' "$v"
  fi
}

read_human_fields() {
  local line
  production=""
  note=""
  [[ -f "$1" ]] || return 0
  while IFS= read -r line; do
    case "$line" in
      clip:*|orphan:*) break ;;
      production:*) [[ -z "$production" ]] && production="$(trim "${line#production:}")" ;;
      note:*) [[ -z "$note" ]] && note="$(trim "${line#note:}")" ;;
    esac
  done < "$1"
}

read_clip_fields() {
  local line current=""
  [[ -f "$1" ]] || return 0
  while IFS= read -r line; do
    case "$line" in
      clip:*)
        current="$(trim "${line#clip:}")"
        ;;
      id:*)
        [[ -n "$current" && -z "${clip_id[$current]:-}" ]] && clip_id["$current"]="$(trim "${line#id:}")"
        ;;
      comment:*)
        [[ -n "$current" && -z "${clip_comment[$current]+x}" ]] && clip_comment["$current"]="$(trim "${line#comment:}")"
        ;;
    esac
  done < "$1"
}

new_clip_id() {
  local mag="$1" clip="$2" hex
  hex=$(od -An -N4 -tx1 /dev/urandom)
  hex=${hex//[[:space:]]/}
  hex=${hex:0:5}
  printf '%s_%s_%s' "$mag" "$clip" "$hex"
}

fill_picture_ffprobe() {
  local file="$1" line section="" acodec="" pending_name=""
  width="" height="" frame_rate="" duration="" codec_name="" audio="" timecode=""
  local -a audio_parts=()
  local probe_tmp
  command -v "$ffprobe" >/dev/null 2>&1 || return 0
  probe_tmp=$(mktemp)
  # ffprobe prints codec_name before codec_type. The section wrappers are the
  # stream boundary. Without them the next stream's name is filed on the previous type.
  "$ffprobe" -v error -hide_banner \
    -show_entries stream=codec_type,codec_name,width,height,avg_frame_rate,channels \
    -show_entries format=duration:format_tags=timecode:stream_tags=timecode \
    -of default "$file" > "$probe_tmp" 2>/dev/null || true
  while IFS= read -r line; do
    case "$line" in
      \[STREAM\]*)
        section=""
        pending_name=""
        ;;
      codec_type=*)
        section=${line#codec_type=}
        if [[ -n "$pending_name" ]]; then
          if [[ "$section" == video && -z "$codec_name" ]]; then
            codec_name=$pending_name
          elif [[ "$section" == audio ]]; then
            acodec=$pending_name
          fi
          pending_name=""
        fi
        ;;
      codec_name=*)
        if [[ -z "$section" ]]; then
          pending_name=${line#codec_name=}
        elif [[ "$section" == video && -z "$codec_name" ]]; then
          codec_name=${line#codec_name=}
        elif [[ "$section" == audio ]]; then
          acodec=${line#codec_name=}
        fi
        ;;
      width=*) [[ "$section" == video && -z "$width" ]] && width=${line#width=} ;;
      height=*) [[ "$section" == video && -z "$height" ]] && height=${line#height=} ;;
      avg_frame_rate=*)
        if [[ "$section" == video && -z "$frame_rate" && "${line#avg_frame_rate=}" != "0/0" ]]; then
          frame_rate=${line#avg_frame_rate=}
        fi
        ;;
      channels=*)
        if [[ "$section" == audio ]]; then
          audio_parts+=("${acodec:-unknown} x ${line#channels=}")
        fi
        ;;
      duration=*) [[ -z "$duration" ]] && duration=${line#duration=} ;;
      TAG:timecode=*) [[ -z "$timecode" ]] && timecode=${line#TAG:timecode=} ;;
    esac
  done < "$probe_tmp"
  rm -f "$probe_tmp"
  if [[ ${#audio_parts[@]} -gt 0 ]]; then
    audio="${audio_parts[0]}"
    local i
    for ((i = 1; i < ${#audio_parts[@]}; i++)); do
      audio+=", ${audio_parts[$i]}"
    done
  fi
}

fill_picture_red() {
  local text="$1" line key val frames="" fps=""
  width="" height="" frame_rate="" duration="" timecode=""
  codec_name="REDCODE"
  audio=""
  while IFS= read -r line; do
    line="${line//$'\r'/}"
    [[ "$line" =~ ^[[:space:]]*([^:]+):[[:space:]]*(.*)$ ]] || continue
    key="$(trim "${BASH_REMATCH[1]}")"
    val="$(trim "${BASH_REMATCH[2]}")"
    [[ -z "$val" ]] && continue
    if [[ "$val" == *": "* ]]; then
      key="$(trim "${val%%:*}")"
      val="$(trim "${val#*:}")"
    fi
    case "$key" in
      "Frame Width"|"Image Width") width=$val ;;
      "Frame Height"|"Image Height") height=$val ;;
      FPS|"Frame Rate"|"Record FPS"|"Record Framerate") fps=$val ;;
      "Total Frames"|"Frame Count") frames=$val ;;
      Duration) duration=$val ;;
      "Start Timecode"|"Absolute Timecode"|"Edge Timecode"|"Timecode"|"Start Absolute Timecode")
        [[ -z "$timecode" ]] && timecode=$val
        ;;
    esac
  done <<< "$text"
  if [[ -n "$fps" ]]; then
    if [[ "$fps" =~ ^[0-9]+(\.0+)?$ ]]; then
      frame_rate="${fps%%.*}/1"
    else
      frame_rate=$fps
    fi
  fi
  if [[ -z "$duration" && -n "$frames" && -n "$fps" ]]; then
    duration=$(awk -v f="$frames" -v r="$fps" 'BEGIN { if (r+0 == 0) exit 1; printf "%.2f", f/r }') || duration=""
  fi
}

probe_red() {
  local file="$1" text
  width="" height="" frame_rate="" duration="" timecode="" codec_name="" audio=""
  if command -v "$redline" >/dev/null 2>&1; then
    text=$("$redline" --i "$file" --printMeta 1 2>&1 || true)
    fill_picture_red "$text"
  else
    codec_name="REDCODE"
    echo "redline not found: ${file##*/}" >&2
    log_error "redline-missing ${base:-} ${file##*/}"
  fi
}

probe_other_media() {
  local file="$1"
  fill_picture_ffprobe "$file"
}

write_block() {
  local clip="$1" spans="${2:-}" mag="$3" id comment
  id="${clip_id[$clip]:-}"
  [[ -n "$id" ]] || id=$(new_clip_id "$mag" "$clip")
  comment="${clip_comment[$clip]-}"
  {
    printf 'clip: %s\n' "$clip"
    printf 'id: %s\n' "$id"
    [[ -n "$spans" ]] && printf 'spans: %s\n' "$spans"
    printf 'width: %s\n' "$(known "$width")"
    printf 'height: %s\n' "$(known "$height")"
    printf 'frame_rate: %s\n' "$(known "$frame_rate")"
    printf 'duration: %s\n' "$(known "$duration")"
    printf 'codec: %s\n' "$(known "$codec_name")"
    printf 'audio: %s\n' "$(known "$audio")"
    printf 'timecode: %s\n' "$(known "$timecode")"
    printf 'comment: %s\n' "$comment"
  } >> "$card_tmp"
}

process_folder() {
  local dir="$1" base="$2"
  local card media=() names=() f name
  local -a rows=() orphan_names=()
  local -A span_of=() row_prefix=()
  card="${dir}${base}${card_suffix}"

  if find "$dir" -maxdepth 1 -type f -newermt "-${settle_seconds} seconds" -print -quit | grep -q .; then
    echo "skip settle: $base"
    return 0
  fi

  shopt -s nullglob
  for f in "$dir"*; do
    [[ -f "$f" ]] || continue
    name="${f##*/}"
    has_ext "$name" "$media_extensions" || continue
    media+=("$f")
    names+=("$name")
  done

  for name in "$base" "${names[@]+"${names[@]}"}"; do
    if ! is_dated_name "$name"; then
      local dest="${relog}/${base}"
      if [[ -e "$dest" ]]; then
        echo "relog refused: $base"
        log_error "relog-refused ${base}"
        return 0
      fi
      if mv "$dir" "$dest"; then
        echo "relog: $base"
        log_error "relog ${base}"
      else
        echo "relog failed: $base" >&2
        log_error "relog-failed ${base}"
      fi
      return 0
    fi
  done

  if [[ ${#media[@]} -eq 0 ]]; then
    echo "no media: $base"
    local seen=0 line
    if [[ -f "$ERROR_LOG" ]]; then
      while IFS= read -r line; do
        [[ "$line" == *" no-media ${base}" ]] && seen=1 && break
      done < "$ERROR_LOG"
    fi
    [[ "$seen" -eq 0 ]] && log_error "no-media ${base}"
    return 0
  fi

  if [[ -f "$card" ]]; then
    local newer=0
    for f in "${media[@]}"; do
      [[ "$f" -nt "$card" ]] && newer=1 && break
    done
    if [[ "$newer" -eq 0 ]]; then
      echo "skip carded: $base"
      return 0
    fi
  fi

  local prefix num
  for f in "${media[@]}"; do
    name="${f##*/}"
    if has_ext "$name" ".r3d" && [[ "$name" =~ ^(.+)_([0-9]{3})\.[Rr]3[Dd]$ ]]; then
      prefix="${BASH_REMATCH[1]}"
      num="${BASH_REMATCH[2]}"
      if [[ "$num" == "001" ]]; then
        rows+=("$f")
        row_prefix["$prefix"]=1
      else
        span_of["$prefix"]+="${span_of[$prefix]:+$'\n'}${name}"
      fi
    else
      rows+=("$f")
    fi
  done
  if [[ ${#span_of[@]} -gt 0 ]]; then
    for prefix in "${!span_of[@]}"; do
      [[ -n "${row_prefix[$prefix]:-}" ]] && continue
      orphan_names+=("${span_of[$prefix]}")
    done
  fi

  card_tmp=$(mktemp "${dir}.card.XXXXXX")
  clip_id=()
  clip_comment=()
  read_human_fields "$card"
  read_clip_fields "$card"
  {
    printf 'folder: %s\n' "$base"
    printf 'date: %s\n' "${base:0:4}-${base:5:2}-${base:8:2}"
    [[ -n "$copyright" ]] && printf 'copyright: %s\n' "$copyright"
    [[ -n "$owner" ]] && printf 'owner: %s\n' "$owner"
    printf 'production: %s\n' "$production"
    printf 'note: %s\n' "$note"
    printf '\n'
  } > "$card_tmp"

  if [[ ${#orphan_names[@]} -gt 0 ]]; then
    local o list
    list=$(mktemp)
    printf '%s\n' "${orphan_names[@]}" | sort -u > "$list"
    while IFS= read -r o; do
      [[ -n "$o" ]] && printf 'orphan: %s\n' "$o" >> "$card_tmp"
    done < "$list"
    rm -f "$list"
    printf '\n' >> "$card_tmp"
  fi

  local sorted spans="" first=1 list
  list=$(mktemp)
  if [[ ${#rows[@]} -gt 0 ]]; then
    printf '%s\0' "${rows[@]}" | sort -z > "$list"
  fi
  while IFS= read -r -d '' sorted || [[ -n "${sorted:-}" ]]; do
    [[ -n "$sorted" ]] || continue
    name="${sorted##*/}"
    [[ "$first" -eq 0 ]] && printf '\n' >> "$card_tmp"
    first=0
    spans=""
    if has_ext "$name" ".r3d" && [[ "$name" =~ ^(.+)_001\.[Rr]3[Dd]$ ]]; then
      prefix="${BASH_REMATCH[1]}"
      spans="${span_of[$prefix]:-}"
      spans="${spans//$'\n'/ }"
      probe_red "$sorted"
      write_block "$name" "$spans" "$base"
    elif has_ext "$name" ".r3d"; then
      probe_red "$sorted"
      write_block "$name" "" "$base"
    else
      probe_other_media "$sorted"
      write_block "$name" "" "$base"
    fi
  done < "$list"
  rm -f "$list"

  mv -f "$card_tmp" "$card"
  card_tmp=""
  echo "card: $base"
}

main() {
  load_conf
  [[ -d "$logged" ]] || { log_error "logged folder missing ${logged}"; echo "logged folder missing: $logged" >&2; exit 1; }
  mkdir -p "$(dirname "$lock_file")" "$relog" "$error"
  card_tmp=""
  trap '[[ -n "${card_tmp:-}" ]] && rm -f "$card_tmp"' EXIT
  exec 9>"$lock_file"
  if ! flock -n 9; then
    echo "detection already running"
    exit 0
  fi
  local dir base any=0
  shopt -s nullglob
  for dir in "${logged}"/*/; do
    [[ -d "$dir" ]] || continue
    any=1
    base="${dir%/}"
    base="${base##*/}"
    process_folder "$dir" "$base"
  done
  [[ "$any" -eq 1 ]] || echo "no folders in $logged"
}

main "$@"
